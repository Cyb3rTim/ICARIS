# Copy to .env and fill in. Never commit .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (scheme included) when served behind a domain:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://icaris.example.com

# Production only
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_BEHIND_PROXY=true
# DJANGO_HSTS_SECONDS=31536000

# PostgreSQL (leave POSTGRES_DB unset to use SQLite)
# POSTGRES_DB=icaris
# POSTGRES_USER=icaris
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Uploads
# DJANGO_MEDIA_ROOT=/var/lib/icaris/media
